        "description": "Read the signed-in patient's recorded practice sessions, most recent first, optionally filtered by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional category id filter."
            },
            "limit": {
              "type": "number",
              "description": "How many sessions to return (default 20, max 100)."
            }
          }
        },
        "outputSchema": null
      }
    ]
